# Copy to .dev.vars (gitignored) and fill in REAL values from a GitHub OAuth App.
# The values below are placeholders: GitHub answers /login/oauth/authorize with "page not found"
# for an unknown client id, so sign-in will not work until you create the app.
#
# GitHub > Settings > Developer settings > OAuth Apps > New OAuth App
#   Homepage URL:               http://localhost:5173/
#   Authorization callback URL: http://localhost:8787/api/auth/github/callback
#
# The callback URL must match byte for byte, otherwise GitHub rejects the redirect.
GITHUB_CLIENT_ID=local-dev-placeholder
GITHUB_CLIENT_SECRET=local-dev-placeholder

# Cloudflare Turnstile. The values below are Cloudflare's documented TEST keys: the widget always
# passes, so local voting works without registering anything. Replace both for production and add
# the widget domain to the Turnstile site.
DDI_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Local-only sign-in shortcut: adds "Dev sign-in · 730d / 10d" buttons in the header so you can
# click through voting without creating a GitHub OAuth App. It is refused unless DDI_WORKER_ORIGIN
# is plain http, so this can never be turned on in a deployed Worker. Never set it in wrangler.toml.
DDI_DEV_LOGIN_ENABLED=true

DDI_WORKER_ORIGIN=http://localhost:8787
DDI_WEB_ORIGIN=http://localhost:5173
DDI_ALLOWED_ORIGINS=http://localhost:5173
DDI_ADMIN_GITHUB_IDS=900000001
