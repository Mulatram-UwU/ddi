{
  "name": "ddi",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "worker",
    "web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "npm -w worker run dev",
    "dev:web": "npm -w web run dev",
    "typecheck": "npm -w worker run typecheck && npm -w web run typecheck",
    "test": "npm -w worker run test && npm -w web run test",
    "deploy:api": "npm -w worker run deploy"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261012.1": true
  }
}
